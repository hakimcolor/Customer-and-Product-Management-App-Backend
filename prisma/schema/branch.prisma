model Branch {
  id              Int              @id @default(autoincrement())
  name            String
  address         String?
  phone           String?
  email           String?
  status          Boolean          @default(true)
  openingBalance  Float            @default(0)
  users           User[]
  stocks          Stock[]
  purchases       Purchase[]
  sales           Sale[]
  expenses        Expense[]
  stockFroms      StockTransfer[]  @relation("FromBranch")
  stockTos        StockTransfer[]  @relation("ToBranch")
  damages         Damage[]
  accounts        Account[]
  warehouses      Warehouse[]
  stockAdjustments StockAdjustment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("branches")
}

model Warehouse {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  branchId  Int?
  status    Boolean  @default(true)
  stocks    Stock[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("warehouses")
}
