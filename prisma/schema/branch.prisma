model Branch {
  id            Int             @id @default(autoincrement())
  name          String
  address       String?
  phone         String?
  users         User[]
  stocks        Stock[]
  purchases     Purchase[]
  sales         Sale[]
  stockFroms    StockTransfer[] @relation("FromBranch")
  stockTos      StockTransfer[] @relation("ToBranch")
  damages       Damage[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("branches")
}
